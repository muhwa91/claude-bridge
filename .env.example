# claude_bridge 환경설정 예시 — 이 파일을 .env 로 복사해 값을 채우세요.
# .env 는 절대 커밋하지 않습니다(.gitignore 에 포함됨). 디스코드 전용.

# 봇 토큰 (Developer Portal > Bot > Reset Token). 코드·로그·커밋에 평문 금지.
DISCORD_BOT_TOKEN=

# 허용 유저 ID 목록(콤마 구분). 본인 유저 ID만 — 목록 밖 유저는 무시됩니다.
# 확인: 디스코드 개발자 모드 켜고 본인 이름 우클릭 > 사용자 ID 복사.
DISCORD_ALLOWED_USER_IDS=

# claude 작업 1건의 최대 실행 시간(초). 초과 시 프로세스 트리를 강제 종료합니다.
CLAUDE_TIMEOUT_SEC=900

# 원격 지시 대상 프로젝트 루트(모노레포 루트 기준 상대경로). 이 폴더 직속만 대상.
TARGET_ROOT=Hachiware/_Project

# 'ㅁ노래' 재생 + 'ㅁ추가' 대상이 되는 유튜브 재생목록 **ID**(비밀 아님). 비우면 'ㅁ노래' 는 미설정 안내.
# URL 전체가 아니라 `list=` 뒤 ID 만 넣는다 — 예) .../playlist?list=PLfYAqOSmXQFQ → PLfYAqOSmXQFQ
# 재생용 URL 은 코드가 이 ID 로 만들고, 'ㅁ추가'(youtube.PLAYLIST_ID)도 같은 값을 쓴다. 곡 추가는
# 즉시 반영(매 재생 시 yt-dlp 로 재로드).
MUSIC_PLAYLIST_ID=

# 미국주식 다이제스트가 SEC(EDGAR·XBRL)를 조회할 때 보낼 User-Agent. SEC 는 **연락 가능한
# 이메일**을 요구하며 없으면 403 이다(이름만·URL만도 403 — 실측).
# 형식: `<영문 이름> <이메일>`  예) hong gildong hong@example.com
# ⚠️ **한글·비ASCII 금지** — HTTP 헤더는 latin-1 이라 한글이 들어가면 요청이 아예 못 나간다.
#    코드가 미리 걸러 경고를 남기고 SEC 블록만 건너뛴다(카드는 정상 발송).
# 비우면 SEC 블록(펀더멘털·8-K·Form 4)만 '조회 실패'로 나가고 나머지 카드는 정상 발송된다.
SEC_USER_AGENT=
